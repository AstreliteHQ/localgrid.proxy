# @astrelitehq/localgrid is published to GitHub Packages, not the public npm
# registry, so npm needs to know where to look for that scope and how to
# authenticate for it. NODE_AUTH_TOKEN needs read:packages access to
# AstreliteHQ's GitHub Packages. In CI (pages.yml) this is the default
# GITHUB_TOKEN, which works because the localgrid package grants this repo
# Actions read access under its own "Manage Actions access" settings.
# Locally, export it yourself with a personal access token instead.
@astrelitehq:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
